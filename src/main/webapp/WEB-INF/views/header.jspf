<%-- Shared page header + navbar.
     Include it AFTER the page's own taglib directives:  <%@ include file="/WEB-INF/views/header.jspf" %>
     Optional: set pageTitle first with <c:set var="pageTitle" value="..." /> --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'Home' : pageTitle}" /> | Online Quiz System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${ctx}/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-quiz">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${ctx}/">&#127891; Online Quiz System</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <c:choose>
                    <c:when test="${sessionScope.user.role == 'ADMIN'}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/questions">Questions</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/questions/add">Add Question</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/results">Results</a></li>
                    </c:when>
                    <c:when test="${sessionScope.user.role == 'STUDENT'}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/student/dashboard">Quizzes</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/student/history">My Results</a></li>
                    </c:when>
                </c:choose>
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                <c:choose>
                    <c:when test="${not empty sessionScope.user}">
                        <li class="nav-item"><span class="navbar-text text-white me-lg-3">
                            Hi, <c:out value="${sessionScope.user.name}" /></span></li>
                        <li class="nav-item">
                            <form action="${ctx}/logout" method="post" class="d-inline">
                                <input type="hidden" name="csrfToken" value="<c:out value='${empty csrfToken ? sessionScope.csrfToken : csrfToken}' />">
                                <button type="submit" class="btn btn-light btn-sm">Logout</button>
                            </form>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm ms-lg-2" href="${ctx}/register">Register</a></li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
<c:if test="${not empty sessionScope.flashMessage}">
    <div class="alert alert-${empty sessionScope.flashType ? 'info' : sessionScope.flashType} alert-dismissible fade show" role="alert">
        <c:out value="${sessionScope.flashMessage}" />
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <c:remove var="flashMessage" scope="session" />
    <c:remove var="flashType" scope="session" />
</c:if>
